<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>org.webbeans</groupId>
  <artifactId>webbeans-parent</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>WebBeans Platform</name>
  <description>A rich web application platform in the spirit of the NetBeans Platform: server-side Java 8 modules, generated browser client.</description>

  <modules>
    <module>webbeans-core</module>
    <module>webbeans-processor</module>
    <module>webbeans-auth</module>
    <module>webbeans-ui</module>
    <module>webbeans-windows-processor</module>
    <module>webbeans-windows</module>
    <module>webbeans-actions-processor</module>
    <module>webbeans-actions</module>
    <module>webbeans-nodes</module>
    <module>webbeans-charts</module>
    <module>webbeans-scene3d</module>
    <module>webbeans-test</module>
    <module>webbeans-help</module>
    <module>webbeans-modules</module>
    <module>webbeans-server</module>
    <module>webbeans-launcher</module>
    <module>webbeans-demo</module>
    <module>webbeans-tutorial</module>
    <module>workbench</module>
  </modules>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.source>1.8</maven.compiler.source>
    <maven.compiler.target>1.8</maven.compiler.target>
    <!-- NetBeans 12.6: the last platform release targeting JDK 8 -->
    <netbeans.version>RELEASE126</netbeans.version>
    <!-- Jetty 9.4: the last Jetty line running on JDK 8 (with its WebSocket modules and the Servlet 3.1 API) -->
    <jetty.version>9.4.58.v20250814</jetty.version>
    <junit.version>4.13.2</junit.version>
    <slf4j.version>1.7.36</slf4j.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.netbeans.api</groupId>
        <artifactId>org-openide-util-lookup</artifactId>
        <version>${netbeans.version}</version>
      </dependency>
      <dependency>
        <groupId>org.netbeans.api</groupId>
        <artifactId>org-openide-util</artifactId>
        <version>${netbeans.version}</version>
      </dependency>
      <dependency>
        <groupId>org.slf4j</groupId>
        <artifactId>slf4j-api</artifactId>
        <version>${slf4j.version}</version>
      </dependency>
      <dependency>
        <groupId>junit</groupId>
        <artifactId>junit</artifactId>
        <version>${junit.version}</version>
        <scope>test</scope>
      </dependency>
      <dependency>
        <groupId>org.webbeans</groupId>
        <artifactId>webbeans-core</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>org.webbeans</groupId>
        <artifactId>webbeans-auth</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>org.webbeans</groupId>
        <artifactId>webbeans-ui</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>org.webbeans</groupId>
        <artifactId>webbeans-windows</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>org.webbeans</groupId>
        <artifactId>webbeans-actions-processor</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>org.webbeans</groupId>
        <artifactId>webbeans-actions</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>org.webbeans</groupId>
        <artifactId>webbeans-nodes</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>org.webbeans</groupId>
        <artifactId>webbeans-charts</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>org.webbeans</groupId>
        <artifactId>webbeans-scene3d</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>org.webbeans</groupId>
        <artifactId>webbeans-test</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>org.webbeans</groupId>
        <artifactId>webbeans-help</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>org.webbeans</groupId>
        <artifactId>webbeans-modules</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>org.webbeans</groupId>
        <artifactId>webbeans-processor</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>org.webbeans</groupId>
        <artifactId>webbeans-server</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>javax.servlet</groupId>
        <artifactId>javax.servlet-api</artifactId>
        <version>3.1.0</version>
      </dependency>
      <dependency>
        <groupId>org.eclipse.jetty</groupId>
        <artifactId>jetty-server</artifactId>
        <version>${jetty.version}</version>
      </dependency>
      <dependency>
        <groupId>org.eclipse.jetty</groupId>
        <artifactId>jetty-servlet</artifactId>
        <version>${jetty.version}</version>
      </dependency>
      <dependency>
        <groupId>org.eclipse.jetty.websocket</groupId>
        <artifactId>websocket-server</artifactId>
        <version>${jetty.version}</version>
      </dependency>
      <dependency>
        <groupId>org.eclipse.jetty.websocket</groupId>
        <artifactId>websocket-client</artifactId>
        <version>${jetty.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>3.11.0</version>
          <configuration>
            <source>1.8</source>
            <target>1.8</target>
            <showWarnings>true</showWarnings>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>3.2.5</version>
          <configuration>
            <!-- tests compile modules with javax.tools against System.getProperty("java.class.path"),
                 which must therefore be the real class path, not a manifest-only booter jar -->
            <useManifestOnlyJar>false</useManifestOnlyJar>
            <useSystemClassLoader>true</useSystemClassLoader>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-jar-plugin</artifactId>
          <version>3.3.0</version>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>

  <profiles>
    <!-- Building on JDK 9+: the release flag (8) also checks the code against the Java 8 API, not only the bytecode
         level. JDK 8's javac has no such flag, so the setting is tied to the JDK running the build. -->
    <profile>
      <id>jdk9-plus</id>
      <activation>
        <jdk>[9,)</jdk>
      </activation>
      <properties>
        <maven.compiler.release>8</maven.compiler.release>
      </properties>
    </profile>
  </profiles>
</project>
