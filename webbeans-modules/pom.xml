<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.webbeans</groupId>
    <artifactId>webbeans-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>webbeans-modules</artifactId>
  <name>WebBeans Modules Window</name>
  <description>Tools ▸ Modules (administrators): the installed modules, enable/disable/uninstall, upload of a module jar — modules come and go while the application runs.</description>

  <dependencies>
    <dependency>
      <groupId>org.webbeans</groupId>
      <artifactId>webbeans-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.webbeans</groupId>
      <artifactId>webbeans-auth</artifactId>
    </dependency>
    <dependency>
      <groupId>org.webbeans</groupId>
      <artifactId>webbeans-ui</artifactId>
    </dependency>
    <dependency>
      <groupId>org.webbeans</groupId>
      <artifactId>webbeans-windows</artifactId>
    </dependency>
    <dependency>
      <groupId>org.webbeans</groupId>
      <artifactId>webbeans-actions</artifactId>
    </dependency>
    <dependency>
      <groupId>org.webbeans</groupId>
      <artifactId>webbeans-nodes</artifactId>
    </dependency>
    <dependency>
      <groupId>org.webbeans</groupId>
      <artifactId>webbeans-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.netbeans.api</groupId>
      <artifactId>org-openide-util-lookup</artifactId>
    </dependency>
    <dependency>
      <groupId>org.netbeans.api</groupId>
      <artifactId>org-openide-util</artifactId>
    </dependency>
    <dependency>
      <groupId>junit</groupId>
      <artifactId>junit</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <resources>
      <resource>
        <directory>src/main/java</directory>
        <excludes><exclude>**/*.java</exclude></excludes>
      </resource>
      <resource>
        <directory>src/main/resources</directory>
      </resource>
    </resources>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <annotationProcessorPaths>
            <path><groupId>org.webbeans</groupId><artifactId>webbeans-processor</artifactId><version>${project.version}</version></path>
            <path><groupId>org.webbeans</groupId><artifactId>webbeans-windows-processor</artifactId><version>${project.version}</version></path>
            <path><groupId>org.webbeans</groupId><artifactId>webbeans-actions-processor</artifactId><version>${project.version}</version></path>
            <path><groupId>org.netbeans.api</groupId><artifactId>org-openide-util-lookup</artifactId><version>${netbeans.version}</version></path>
          </annotationProcessorPaths>
          <compilerArgs><arg>-Awebbeans.module=org.webbeans.modules</arg></compilerArgs>
        </configuration>
        <executions>
          <!-- the tests carry their own @HelpPage/@TopComponent registrations: generated as a second module
               (org.webbeans.modules.test.generated.WbRegistrations) so they do not shadow the main ones -->
          <execution>
            <id>default-testCompile</id>
            <configuration>
              <compilerArgs><arg>-Awebbeans.module=org.webbeans.modules.test</arg></compilerArgs>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
