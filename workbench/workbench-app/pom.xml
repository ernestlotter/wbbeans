<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.webbeans.workbench</groupId>
    <artifactId>workbench</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>workbench-app</artifactId>
  <name>Workbench Application</name>
  <description>The application jar: the platform, the five Workbench jars and the branding resources merged into one runnable jar. Run: java -jar workbench.jar --branding workbench --title Workbench --datadir data</description>

  <dependencies>
    <dependency>
      <groupId>org.webbeans</groupId>
      <artifactId>webbeans-launcher</artifactId>
    </dependency>
    <dependency>
      <groupId>org.webbeans</groupId>
      <artifactId>webbeans-server</artifactId>
    </dependency>
    <dependency>
      <groupId>org.webbeans</groupId>
      <artifactId>webbeans-charts</artifactId>
    </dependency>
    <dependency>
      <groupId>org.webbeans</groupId>
      <artifactId>webbeans-scene3d</artifactId>
    </dependency>
    <dependency>
      <groupId>org.webbeans</groupId>
      <artifactId>webbeans-help</artifactId>
    </dependency>
    <dependency>
      <groupId>org.webbeans</groupId>
      <artifactId>webbeans-nodes</artifactId>
    </dependency>
    <!-- the application's own jars: on the class path like everything else -->
    <dependency>
      <groupId>org.webbeans.workbench</groupId>
      <artifactId>workbench-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.webbeans.workbench</groupId>
      <artifactId>workbench-files</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.webbeans.workbench</groupId>
      <artifactId>workbench-dashboard</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.webbeans.workbench</groupId>
      <artifactId>workbench-viewer3d</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.webbeans.workbench</groupId>
      <artifactId>workbench-admin</artifactId>
      <version>${project.version}</version>
    </dependency>
  </dependencies>

  <build>
    <finalName>workbench</finalName>
    <plugins>
      <!-- one runnable jar: platform classes + resources, services files concatenated -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.5.1</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals><goal>shade</goal></goals>
            <configuration>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>org.webbeans.launcher.Main</mainClass>
                </transformer>
              </transformers>
              <filters>
                <filter><artifact>*:*</artifact><excludes><exclude>META-INF/*.SF</exclude><exclude>META-INF/*.DSA</exclude><exclude>META-INF/*.RSA</exclude></excludes></filter>
              </filters>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
